{
  "permissions": {
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git add -A:*)",
      "Bash(git add --all:*)",
      "Bash(git add .)",
      "Bash(gh workflow run:*)",
      "Bash(fnm default:*)"
    ],
    "allow": [
      "Bash(pnpm run doctor)",
      "Bash(pnpm run verify:*)",
      "Bash(pnpm run test:*)",
      "Bash(pnpm run dev:capture:status)",
      "Bash(pnpm --filter @holoim/* run doctor)",
      "Bash(pnpm --filter @holoim/* run verify:*)",
      "Bash(pnpm --filter @holoim/* run lint)",
      "Bash(pnpm --filter @holoim/* run typecheck)",
      "Bash(git fetch:*)",
      "Bash(git status:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git pull:*)",
      "Bash(git worktree:*)",
      "Bash(git merge:*)"
    ]
  },
  "enabledPlugins": {
    "vercel@claude-plugins-official": false,
    "Notion@claude-plugins-official": false
  },
  "autoCompactWindow": 250000,
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/agent-node-env.sh"
          },
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && node scripts/hooks/install.mjs >/dev/null 2>&1 || true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/scripts/hooks/guard-main-checkout.mjs"
          }
        ]
      }
    ]
  },
  "model": "sonnet",
  "skillOverrides": {
    "anthropic-skills:canvas-design": "user-invocable-only",
    "anthropic-skills:doc-coauthoring": "user-invocable-only",
    "anthropic-skills:google-workspace": "user-invocable-only",
    "anthropic-skills:morning": "user-invocable-only",
    "anthropic-skills:setup-claude": "user-invocable-only",
    "anthropic-skills:skill-creator": "user-invocable-only",
    "anthropic-skills:web-artifacts-builder": "user-invocable-only",
    "anthropic-skills:deep-research": "user-invocable-only",
    "anthropic-skills:import-memory": "user-invocable-only",
    "anthropic-skills:docs": "name-only",
    "anthropic-skills:docx": "name-only",
    "anthropic-skills:pdf": "name-only",
    "anthropic-skills:pptx": "name-only",
    "anthropic-skills:xlsx": "name-only",
    "claude-api": "user-invocable-only",
    "plugin-authoring": "user-invocable-only",
    "keybindings-help": "user-invocable-only",
    "fewer-permission-prompts": "user-invocable-only",
    "dataviz": "user-invocable-only",
    "init": "user-invocable-only",
    "security-review": "user-invocable-only",
    "browse": "name-only",
    "gstack": "name-only",
    "gstack-upgrade": "name-only",
    "plan-ceo-review": "name-only",
    "plan-eng-review": "name-only",
    "qa": "name-only",
    "retro": "name-only",
    "review": "name-only",
    "setup-browser-cookies": "name-only",
    "ship": "name-only"
  },
  "env": {
    "ENABLE_STOP_REVIEW": "0",
    "SECURITY_REVIEW_MODEL": "claude-sonnet-5-5",
    "SG_AGENTIC_MODEL": "claude-sonnet-5-5"
  }
}

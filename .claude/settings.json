{
  "permissions": {
    "allow": [
      "Bash(pnpm run doctor)",
      "Bash(pnpm run verify:*)",
      "Bash(pnpm run test:*)",
      "Bash(pnpm run dev:capture:status)",
      "Bash(pnpm --filter @holoim/* run doctor)",
      "Bash(pnpm --filter @holoim/* run verify:*)",
      "Bash(pnpm --filter @holoim/* run lint)",
      "Bash(pnpm --filter @holoim/* run typecheck)",
      "Bash(git fetch:*)",
      "Bash(git status:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git pull:*)",
      "Bash(git worktree:*)",
      "Bash(git merge:*)"
    ]
  },
  "enabledPlugins": {
    "vercel@claude-plugins-official": false
  },
  "autoCompactWindow": 400000,
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/agent-node-env.sh"
          }
        ]
      }
    ]
  },
  "model": "sonnet"
}

{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "extends": [
    "../../packages/config-eslint/oxlint/base.json"
  ],
  "ignorePatterns": [
    "**/*.d.ts",
    "**/dist/**",
    "**/coverage/**",
    "**/node_modules/**",
    "**/.turbo/**",
    "output/**",
    ".wrangler/**",
    "*.glb"
  ],
  "rules": {
    "typescript/consistent-type-imports": "off"
  }
}

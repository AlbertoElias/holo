{
  "name": "@holoim/capture",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:runtime": "vite --host 127.0.0.1 --port ${CAPTURE_RUNTIME_PORT:-5174} --strictPort",
    "dev:ai": "iwsdk dev up --ai-mode collaborate --foreground",
    "dev:agent": "iwsdk dev up --ai-mode agent --foreground --screenshot-width 640 --screenshot-height 640",
    "dev:down": "iwsdk dev down",
    "dev:status": "iwsdk dev status",
    "dev:mock-vr": "vite --host 127.0.0.1 --port 5174 --strictPort",
    "iwsdk:adapter:status": "iwsdk adapter status",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run test:unit",
    "test:unit": "vitest run",
    "test:xr": "node --import tsx scripts/run-xr-checks.ts mock-vr recording locomotion terrain hands height body face",
    "test:xr:recording": "node --import tsx scripts/run-xr-checks.ts recording",
    "test:xr:mock": "node --import tsx scripts/run-xr-checks.ts mock-vr",
    "test:xr:flows": "node --import tsx scripts/run-xr-checks.ts locomotion",
    "test:xr:hands": "node --import tsx scripts/run-xr-checks.ts hands",
    "test:xr:height": "node --import tsx scripts/run-xr-checks.ts height",
    "test:xr:terrain": "node --import tsx scripts/run-xr-checks.ts terrain",
    "test:xr:body": "node --import tsx scripts/run-xr-checks.ts body",
    "test:xr:pointing": "node --import tsx scripts/run-xr-checks.ts pointing",
    "test:xr:face": "node --import tsx scripts/run-xr-checks.ts face",
    "fixtures:hands": "node --import tsx scripts/run-xr-checks.ts pose-fixture",
    "fixtures:body": "node --import tsx scripts/run-xr-checks.ts body-fixtures",
    "fixtures:pointing": "node --import tsx scripts/generate-pointing-test-scene.ts && node --import tsx scripts/run-xr-checks.ts pointing-fixture",
    "build": "vite build",
    "preview": "vite preview --host",
    "doctor": "node scripts/doctor.mjs",
    "verify:pr": "pnpm run lint && pnpm run typecheck && pnpm run test:unit && pnpm run test:xr",
    "verify:fast": "pnpm run lint && pnpm run typecheck && pnpm run test:unit",
    "verify:full": "pnpm run verify:pr && pnpm run build",
    "verify:changed": "node scripts/verify-changed.mjs",
    "ci:vr:mock": "node --import tsx scripts/ci-mock-vr-playwright.ts",
    "ci:vr:flows": "node --import tsx scripts/ci-vr-locomotion-playwright.ts",
    "test:vr:mock": "pnpm run test:xr:mock",
    "test:vr:flows": "pnpm run test:xr:flows",
    "check": "pnpm run verify:fast && pnpm run build",
    "build:avatar-face": "node scripts/build-avatar-face.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.20.0",
    "@holoim/avatar-face": "workspace:*",
    "@holoim/meaning": "workspace:*",
    "@holoim/ui-dom": "workspace:*",
    "@holoim/xr-runtime": "workspace:*",
    "@holoim/xr-ui-core": "workspace:*",
    "@holoim/xr-ui-three": "workspace:*",
    "@iwsdk/core": "^1.0.1",
    "@mediapipe/tasks-vision": "0.10.17",
    "@pmndrs/uikit": "1.0.77",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "catalog:"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@gltf-transform/core": "4.3.0",
    "@holoim/config-eslint": "workspace:*",
    "@holoim/config-ts": "workspace:*",
    "@holoim/tooling-scripts": "workspace:*",
    "@holoim/tooling-testing": "workspace:*",
    "@iwsdk/cli": "^1.0.1",
    "@iwsdk/scene-composition": "^1.0.1",
    "@iwsdk/vite-plugin-dev": "^1.0.1",
    "@iwsdk/vite-plugin-gltf-optimizer": "^0.4.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "catalog:",
    "@zappar/msdf-generator": "^1.2.4",
    "eslint": "catalog:",
    "globals": "^16.0.0",
    "iwer": "2.6.0",
    "playwright": "^1.58.2",
    "three-viewport-gizmo": "^2.2.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "webxr-polyfill": "catalog:"
  },
  "engines": {
    "node": ">=24 <25"
  }
}

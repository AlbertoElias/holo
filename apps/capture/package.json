{
  "name": "@holoim/capture",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock-vr": "vite --host 127.0.0.1 --port 5174 --strictPort",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsgo --noEmit",
    "test:unit": "vitest run",
    "test:xr:mock": "node scripts/run-mock-vr-check.mjs",
    "test:xr:flows": "node scripts/run-vr-locomotion-check.mjs",
    "build": "vite build",
    "preview": "vite preview --host",
    "doctor": "node scripts/doctor.mjs",
    "verify:pr": "pnpm run lint && pnpm run typecheck && pnpm run test:unit && pnpm run test:xr:mock",
    "verify:fast": "pnpm run lint && pnpm run typecheck && pnpm run test:unit",
    "verify:full": "pnpm run verify:pr && pnpm run test:xr:flows && pnpm run build",
    "verify:changed": "node scripts/verify-changed.mjs",
    "ci:vr:mock": "node scripts/ci-mock-vr-playwright.mjs",
    "ci:vr:flows": "node scripts/ci-vr-locomotion-playwright.mjs",
    "test:vr:mock": "pnpm run test:xr:mock",
    "test:vr:flows": "pnpm run test:xr:flows",
    "check": "pnpm run verify:fast && pnpm run build"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.19.3",
    "three": "catalog:"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@holoim/config-eslint": "workspace:*",
    "@holoim/tooling-scripts": "workspace:*",
    "@holoim/tooling-testing": "workspace:*",
    "@iwsdk/vite-plugin-gltf-optimizer": "^0.3.1",
    "@iwsdk/vite-plugin-iwer": "^0.2.2",
    "@types/three": "catalog:",
    "@typescript/native-preview": "latest",
    "@vitejs/plugin-basic-ssl": "^2.1.4",
    "eslint": "catalog:",
    "globals": "^16.0.0",
    "playwright": "^1.58.2",
    "typescript": "catalog:",
    "typescript-eslint": "^8.26.1",
    "vite": "catalog:",
    "vitest": "catalog:",
    "webxr-polyfill": "catalog:"
  },
  "engines": {
    "node": ">=20 <21"
  }
}

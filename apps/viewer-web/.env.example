# Origin of the viewer API (no trailing slash). Empty = same origin / Vite proxy.
# Production example: https://holoim-api.fly.dev
VITE_API_ORIGIN=

# Origin of capture, which Record opens with a post grant (no trailing slash).
# Empty = https://localhost:5173 (capture dev). Production: https://holoim-capture.pages.dev
VITE_CAPTURE_ORIGIN=

{
  "name": "@holoim/knowledge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "pnpm run check:docs && tsgo --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4176 --strictPort",
    "lint": "eslint .",
    "typecheck": "tsgo --noEmit",
    "check:docs": "tsx tooling/check-docs.ts",
    "test:e2e": "pnpm run check:docs && playwright test",
    "verify:fast": "pnpm run check:docs && pnpm run lint && pnpm run typecheck",
    "verify:full": "pnpm run verify:fast && pnpm run build && pnpm run test:e2e"
  },
  "dependencies": {
    "mermaid": "^11.17.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.3",
    "remark-gfm": "^4.0.0",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@holoim/config-eslint": "workspace:*",
    "@holoim/config-ts": "workspace:*",
    "@playwright/test": "^1.50.1",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.13.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "catalog:",
    "vite": "catalog:"
  }
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Hologram {
  id               String    @id @default(cuid())
  filenameOriginal String
  hologramName     String
  submittedBy      String
  filenameStored   String
  mimeType         String
  sizeBytes        Int
  storagePath      String
  durationSec      Float?
  usdzPath         String?
  usdzStatus       String    @default("none")
  usdzClaimedAt    DateTime?
  usdzClaimToken   String?
  usdzAttempts     Int       @default(0)
  usdzError        String?
  createdAt        DateTime  @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([usdzStatus])
}

model UploadIntent {
  id                  String    @id @default(cuid())
  storageKey          String    @unique
  filenameOriginal    String
  hologramName        String
  submittedBy         String
  mimeType            String
  sizeBytes           Int
  expiresAt           DateTime
  completedHologramId String?   @unique
  createdAt           DateTime  @default(now())
}

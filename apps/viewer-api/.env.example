DATABASE_URL="file:./prisma/dev.db"
PORT=3001
WEB_ORIGIN="https://localhost:3174"

# Optional: comma-separated extra web origins. One `*.` wildcard per entry
# is supported, e.g. WEB_ORIGINS="https://holoim-viewer.pages.dev,https://*.holoim-viewer.pages.dev"
# WEB_ORIGINS=
# Optional: absolute uploads directory (defaults to ./uploads).
# UPLOADS_ROOT=/data/uploads

# Storage: "local" (default, disk under UPLOADS_ROOT) or "s3" (R2/S3 direct uploads).
STORAGE_DRIVER=local
# S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
# S3_REGION=auto
# S3_BUCKET="holoim-media"
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# PUBLIC_MEDIA_BASE_URL="https://media.example.com"

# Async USDZ worker (embedded in the API process).
USDZ_WORKER_ENABLED=true
# USDZ_POLL_INTERVAL_MS=2000
# USDZ_STALE_CLAIM_MS=600000

# Optional: Python executable with tools/requirements.txt installed (default python3).
# USDZ_PYTHON=/absolute/path/to/venv/bin/python3

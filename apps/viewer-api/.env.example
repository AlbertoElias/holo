DATABASE_URL="file:./prisma/dev.db"
PORT=3001
WEB_ORIGIN="https://localhost:3174"

# Optional: comma-separated extra web origins. One `*.` wildcard per entry
# is supported, e.g. WEB_ORIGINS="https://*.example.pages.dev". Localhost and
# the holoim-viewer/holoim-capture Pages preview hosts are always allowed.
# WEB_ORIGINS=
# Optional: absolute uploads directory (defaults to ./uploads).
# UPLOADS_ROOT=/data/uploads

# Storage: "local" (default, disk under UPLOADS_ROOT) or "s3" (R2/S3 direct uploads).
STORAGE_DRIVER=local
# S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
# S3_REGION=auto
# S3_BUCKET="holoim-media"
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# PUBLIC_MEDIA_BASE_URL="https://media.example.com"

# Expired upload-intent cleanup (embedded in the API process, hourly by default).
# UPLOAD_INTENT_CLEANUP_ENABLED=true
# UPLOAD_INTENT_CLEANUP_INTERVAL_MS=3600000
# UPLOAD_INTENT_GRACE_MS=900000
# UPLOAD_INTENT_COMPLETED_RETENTION_MS=86400000

# Async USDZ worker (embedded in the API process).
USDZ_WORKER_ENABLED=true
# USDZ_POLL_INTERVAL_MS=2000
# USDZ_STALE_CLAIM_MS=600000

# Optional: Python executable with tools/requirements.txt installed (default python3).
# USDZ_PYTHON=/absolute/path/to/venv/bin/python3

# Object search (PRD-060). Defaults reach the live registry; the e2e points at a local fixture.
# POLYHAVEN_API_ORIGIN=https://api.polyhaven.com
# POLYHAVEN_ALLOWED_HOSTS=dl.polyhaven.org,cdn.polyhaven.com
# Poly Pizza is searched only with a key (poly.pizza/settings/api); without
# one, or when it fails, search shows Poly Haven alone.
# POLYPIZZA_API_KEY=
# POLYPIZZA_API_ORIGIN=https://api.poly.pizza/v1.1
# POLYPIZZA_ALLOWED_HOSTS=static.poly.pizza
# Origins besides WEB_ORIGIN/WEB_ORIGINS that may call /api/objects/* (the
# capture app; one `*.` wildcard per entry). Localhost is always allowed.
# CAPTURE_ORIGINS=https://holoim-capture.pages.dev,https://*.holoim-capture.pages.dev

# Voice search (POST /api/objects/transcribe) through Cloudflare Workers AI
# Whisper. Off (503, capture falls back to typing) unless both are set; the
# token needs Workers AI read and run permission.
# WORKERS_AI_ACCOUNT_ID=
# WORKERS_AI_API_TOKEN=
# WORKERS_AI_API_ORIGIN=https://api.cloudflare.com/client/v4

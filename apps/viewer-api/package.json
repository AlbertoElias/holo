{
  "name": "@holoim/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run prisma:setup && tsx watch src/server.ts",
    "build": "pnpm run prisma:generate && tsc -p tsconfig.json",
    "lint": "eslint .",
    "typecheck": "pnpm run prisma:generate && tsc -p tsconfig.typecheck.json --noEmit",
    "test": "vitest run",
    "verify:fast": "pnpm run lint && pnpm run typecheck && pnpm run test",
    "verify:full": "pnpm run verify:fast && pnpm run build",
    "prisma:generate": "prisma generate",
    "prisma:setup": "pnpm run prisma:generate && prisma migrate deploy",
    "prisma:migrate": "prisma migrate dev --name init"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^8.1.1",
    "@holoim/contracts": "workspace:*",
    "@paralleldrive/cuid2": "^2.2.2",
    "@prisma/client": "^6.3.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@holoim/config-eslint": "workspace:*",
    "@holoim/config-ts": "workspace:*",
    "@types/node": "^22.13.0",
    "eslint": "catalog:",
    "prisma": "^6.3.1",
    "tsx": "^4.19.2",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}

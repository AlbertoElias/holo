{
  "$description": "HoloIM design tokens, W3C Design Tokens format 2025.10. Machine-readable copy of docs/product/design/styleguide.md, which wins where the two differ. Dimensions in px are angular px (1 apx = 1 CSS reference px, about 0.0213 deg of view). Plain numbers under edge are shares of the hologram's short side. Every value is a rule; undecided items have no token.",
  "$extensions": {
    "holoim": {
      "version": "2026-10-24",
      "sizeFormula": "size_m = apx * 0.000372 * distance_m * scale",
      "questPxPerApx": 0.53,
      "headsetScale": {
        "value": 2.5,
        "appliesTo": [
          "type",
          "icons",
          "glyph strokes",
          "rings",
          "glyph gaps",
          "chip shape"
        ],
        "notTo": [
          "hit areas"
        ]
      }
    }
  },
  "size": {
    "$description": "Angular size: size_m = apx × radiansPerApx × distance_m, times headsetScale for type, icons, glyph strokes, rings, glyph gaps and the chip's shape in a headset; never for hit areas",
    "radiansPerApx": {
      "$type": "number",
      "$value": 0.000372,
      "$description": "1 apx is about 0.0213 deg of view"
    },
    "headsetScale": {
      "$type": "number",
      "$value": 2.5
    }
  },

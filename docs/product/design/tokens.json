  "motion": {
    "easeInOut": {
      "$type": "cubicBezier",
      "$value": [
        0.42,
        0,
        0.58,
        1
      ]
    },
    "easeOut": {
      "$type": "cubicBezier",
      "$value": [
        0,
        0,
        0.58,
        1
      ]
    },
    "chrome": {
      "$description": "Chrome unfolds",
      "in": {
        "$type": "duration",
        "$value": {
          "value": 240,
          "unit": "ms"
        }
      },
      "out": {
        "$type": "duration",
        "$value": {
          "value": 400,
          "unit": "ms"
        }
      },
      "easing": {
        "$type": "cubicBezier",
        "$value": "{motion.easeOut}"
      }
    },
    "flicker": {
      "period": {
        "$type": "duration",
        "$value": {
          "value": 2600,
          "unit": "ms"
        }
      },
      "stageLightRest": {
        "$type": "number",
        "$value": 0.9
      },
      "$extensions": {
        "holoim": {
          "flatHaloKeyframes": [
            {
              "at": 0,
              "level": 0.5
            },
            {
              "at": 0.4,
              "level": 0.32
            },
            {
              "at": 0.55,
              "level": 0.58
            },
            {
              "at": 0.7,
              "level": 0.4
            },
            {
              "at": 1,
              "level": 0.5
            }
          ],
          "easing": "{motion.easeInOut}",
          "flatStageLight": "0.9 + 0.12 * sin(9t) * sin(3.7t), t in seconds",
          "xrHalo": "0.45 + (flatHalo(t) - 0.32) * 0.05 / 0.26",
          "xrStageLight": "steady at stageLightRest; never flickers on real surfaces",
          "arQuickLook": "none"
        }
      }
    },
    "sparks": {
      "countFlat": {
        "$type": "number",
        "$value": 26
      },
      "countRoomMax": {
        "$type": "number",
        "$value": 70
      },
      "sizeMin": {
        "$type": "number",
        "$value": 0.004,
        "$description": "Share of the short side"
      },
      "sizeMax": {
        "$type": "number",
        "$value": 0.008
      },
      "lifeMin": {
        "$type": "duration",
        "$value": {
          "value": 2000,
          "unit": "ms"
        }
      },
      "lifeMax": {
        "$type": "duration",
        "$value": {
          "value": 4000,
          "unit": "ms"
        }
      },
      "$extensions": {
        "holoim": {
          "who": {
            "xr": "the hologram nearest the head's forward ray; none in peripheral vision",
            "phone": "the card nearest the middle of the screen",
            "desktop": "the card nearest the middle of the window"
          },
          "unfocused": "steady halo at edge.halo.level; no redraw on phones"
        }
      }
    },
    "reducedMotion": {
      "haloFrom": {
        "$type": "number",
        "$value": 0.5
      },
      "haloTo": {
        "$type": "number",
        "$value": 0.489
      },
      "period": {
        "$type": "duration",
        "$value": {
          "value": 8000,
          "unit": "ms"
        }
      },
      "easing": {
        "$type": "cubicBezier",
        "$value": "{motion.easeInOut}"
      },
      "$extensions": {
        "holoim": {
          "sparks": false,
          "stageLight": "steady",
          "headsets": "same fade",
          "chrome": "crossfade in place"
        }
      }
    },
    "recording": {
      "flatHaloLevel": {
        "$type": "number",
        "$value": 0.08
      },
      "flatCoreAndHighlightOpacity": {
        "$type": "number",
        "$value": 0.55
      },
      "$extensions": {
        "holoim": {
          "sparks": false,
          "headset": "no edge while recording",
          "chrome": "all hidden except the stop control and the running time"
        }
      }
    }
  },
  "quickLook": {
    "$description": "AR Quick Look USDZ: the edge with a baked halo, static; added when the server builds the USDZ, never in the exported GLB",
    "$extensions": {
      "holoim": {
        "strokes": [
          "edge.halo",
          "edge.core",
          "edge.highlight"
        ]
      }

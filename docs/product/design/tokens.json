  "ground": {
    "flat": {
      "$type": "gradient",
      "$value": [
        {
          "color": "{color.ground.top}",
          "position": 0
        },
        {
          "color": "{color.ground.mid}",
          "position": 0.48
        },
        {
          "color": "{color.ground.grey}",
          "position": 0.8
        },
        {
          "color": "{color.ground.horizon}",
          "position": 1
        }
      ],
      "$description": "Top to bottom (180deg), pinned to the screen, not the page"
    },
    "bottomBandStart": {
      "$type": "number",
      "$value": 0.75,
      "$description": "Share of screen height from the top; nothing bare below it"
    },
    "$extensions": {
      "holoim": {
        "vr": "not painted: the blue-hour room",
        "ar": "not painted: the camera image"
      }
    }
  },
  "chip": {
    "$description": "Flat color.deepSea, no backdrop blur, no rim; never opaque in AR",
    "color": {
      "$type": "color",
      "$value": "{color.deepSea}"
    },
    "opacity": {
      "vr": {
        "$type": "number",
        "$value": 0.72
      },
      "arQuestPassthrough": {
        "$type": "number",
        "$value": 0.97
      },
      "arAndroidChrome": {
        "$type": "number",
        "$value": 0.88
      },
      "arLinear": {
        "$type": "number",
        "$value": 0.92,
        "$description": "Any AR target that blends in linear light"
      },
      "flat": {
        "$type": "number",
        "$value": 0.72,
        "$description": "Feed-wide notices"
      },
      "flatOverPicture": {
        "$type": "number",
        "$value": 0.72,
        "$description": "Text over a hologram's own picture on flat screens; muted text 4.46:1 over pure white, accepted"
      }
    },
    "radius": {
      "$type": "dimension",
      "$value": {
        "value": 18,
        "unit": "px"
      }
    },
    "paddingBlock": {
      "$type": "dimension",
      "$value": {
        "value": 5,
        "unit": "px"
      }
    },
    "paddingInline": {
      "$type": "dimension",
      "$value": {
        "value": 14,
        "unit": "px"
      }
    },
    "controlRowPaddingStart": {
      "$type": "dimension",
      "$value": {
        "value": 3,
        "unit": "px"
      },
      "$description": "Also top and bottom; the end keeps paddingInline"
    },
    "vrFadeIn": {
      "$type": "duration",
      "$value": {
        "value": 300,
        "unit": "ms"
      }
    },
    "vrMinHold": {
      "$type": "duration",
      "$value": {
        "value": 2000,
        "unit": "ms"
      }
    },
    "$extensions": {
      "holoim": {
        "rule": {
          "vr": "bare against the room's walls; chip in front of the sky, a hologram or a lit surface",
          "ar": "every row and label",
          "arQuickLook": "none possible",
          "flat": "feed-wide notices; controls and captions use the shade",
          "overHologramPicture": "always; chip.opacity.flatOverPicture on flat screens"
        }
      }
    },
    "vrFadeOut": {
      "$type": "duration",
      "$value": "{motion.chrome.out}",
      "$description": "Set by the lead in slice 2: the chip leaves as chrome does"
    }
  },
  "shade": {
    "$description": "Soft dark shade at a hologram's foot on flat screens; holds its controls and caption; moves with its card",
    "inner": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.0314,
          0.102,
          0.1176
        ],
        "hex": "#081a1e",
        "alpha": 0.7
      }
    },
    "mid": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.0314,
          0.102,
          0.1176
        ],
        "hex": "#081a1e",
        "alpha": 0.5
      }
    },
    "midStop": {
      "$type": "number",
      "$value": 0.6
    },
    "widthOfHologram": {
      "$type": "number",
      "$value": 1.2
    },
    "labelRim": {
      "$type": "number",
      "$value": 0.45,
      "$description": "Keep labels inside this share of the shade's radius"
    },
    "$extensions": {
      "holoim": {
        "css": "radial-gradient(closest-side, rgba(8,26,30,.7), rgba(8,26,30,.5) 60%, rgba(8,26,30,0))",
        "phoneDock": "the phone's bottom dock sits on the same shade spread along the bottom of the screen"
      }
    },
    "startMin": {
      "$type": "number",
      "$value": 0.9,
      "$description": "The shade starts this far down the card, at the least"
    },
    "startMax": {
      "$type": "number",
      "$value": 0.95,
      "$description": "... and at the most"
    },
    "heightDesktop": {
      "$type": "dimension",
      "$value": {
        "value": 120,
        "unit": "px"
      }
    },
    "heightPhoneOfScreen": {
      "$type": "number",
      "$value": 0.24,
      "$description": "Share of the screen's height on a phone"
    }
  },
  "edge": {
    "$description": "Burnt; shares of the short side at every size, no floor or cap; never baked into GLB",
    "radius": {
      "$type": "number",
      "$value": 0.07
    },
    "waveAmplitude": {
      "$type": "number",
      "$value": 0.02
    },
    "wavesMin": {
      "$type": "number",
      "$value": 3
    },
    "wavesMax": {
      "$type": "number",
      "$value": 9
    },
    "tearAmplitude": {
      "$type": "number",
      "$value": 0.009
    },
    "tearsMin": {
      "$type": "number",
      "$value": 16
    },
    "tearsMax": {
      "$type": "number",
      "$value": 38
    },
    "jitter": {
      "$type": "number",
      "$value": 0.007
    },
    "insetMin": {
      "$type": "number",
      "$value": 0.06,
      "$description": "Inset is the larger of this and edge.halo.width"
    },
    "samples": {
      "$type": "number",
      "$value": 280,
      "$description": "Seeded per hologram"
    },
    "halo": {
      "width": {
        "$type": "number",
        "$value": 0.06
      },
      "color": {
        "$type": "color",
        "$value": "{color.glow}"
      },
      "level": {
        "$type": "number",
        "$value": 0.5,
        "$description": "Resting level on flat screens"
      },
      "blurStdDevOfWidth": {
        "$type": "number",
        "$value": 0.5
      },
      "material3DRest": {
        "$type": "number",
        "$value": 0.9,
        "$description": "3D halo material opacity = min(1, material3DRest * level / level at rest)"
      }
    },
    "core": {
      "width": {
        "$type": "number",
        "$value": 0.014
      },
      "color": {
        "$type": "color",
        "$value": "{color.gold}"
      }
    },
    "highlight": {
      "width": {
        "$type": "number",
        "$value": 0.004
      },
      "color": {
        "$type": "color",
        "$value": "{color.highlight}"
      }
    },
    "soot": {
      "$description": "Same width and blur as the halo; crossfades with it; never flickers",
      "color": {
        "$type": "color",
        "$value": "{color.deepSea}"
      },
      "flatOpacity": {
        "$type": "number",
        "$value": 0.6
      },
      "vrOpacity": {
        "$type": "number",
        "$value": 0.6,
        "$description": "VR: the flat rule, t(L) from the luminance of the VR room behind the edge"
      },
      "arOpacity": {
        "$type": "number",
        "$value": 1,
        "$description": "AR with a lighting estimate (Android Chrome), when the estimate says bright"
      },
      "arNoEstimateOpacity": {
        "$type": "number",
        "$value": 1,
        "$description": "AR with no lighting estimate (Quest passthrough): soot always on"
      },
      "blendFromLuminance": {
        "$type": "number",
        "$value": 0.095,
        "$description": "t = 0: all glow"
      },
      "blendToLuminance": {
        "$type": "number",
        "$value": 0.16,
        "$description": "t = 1: all soot"
      },
      "arOnLuminance": {
        "$type": "number",
        "$value": 0.16,
        "$description": "AR with an estimate: soot on when the ambient SH coefficient's relative luminance is at or above this"
      },
      "arOffLuminance": {
        "$type": "number",
        "$value": 0.095,
        "$description": "AR with an estimate: soot off when that luminance falls below this (hysteresis)"
      },
      "$extensions": {
        "holoim": {
          "formula": {
            "t": "clamp((L - 0.095) / (0.16 - 0.095), 0, 1)",
            "tAR": "1 from ambient Y >= 0.16 until Y < 0.095, else 0; Y = 0.2126 R + 0.7152 G + 0.0722 B of the first SH coefficient",
            "glow": "level * (1 - t)",
            "soot": "opacity * t"
          },
          "arNoEstimate": "soot at full opacity, t = 1"
        }
      }
    },
    "char": {
      "$description": "The burnt line beside the gold on the cloche's rim: part of the edge, never a shadow around it. It strengthens where soot used to show (light ground, bright AR rooms)",
      "color": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.4196,
            0.2078,
            0.0784
          ],
          "hex": "#6b3514"
        }
      },
      "rest": {
        "$type": "number",
        "$value": 0.35,
        "$description": "Char share at rest, on dark ground"
      },
      "bright": {
        "$type": "number",
        "$value": 1,
        "$description": "Char share where the old soot rule says light ground or a bright room"
      }
    },
    "ember": {
      "$description": "Where an ember or a spark cools, at the end of its life: the burnt globe's third colour after cream and gold",
      "color": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.7608,
            0.2549,
            0.0471
          ],
          "hex": "#c2410c"
        }
      }
    },
    "cloche": {
      "$description": "The 3D halo (decided 2026-10-25, burnt globe 2026-10-25): a dome resting on the hologram's floor, fitted to what is drawn, burnt through so only torn burning fronts remain, with embers in its surface and sparks shed from the fronts. Quiet where it faces you over the event, full at its silhouette and on its far side. World-anchored; the exported GLB never holds it",
      "exponent": {
        "$type": "number",
        "$value": 2.6,
        "$description": "Superellipsoid exponent: one shoulder curvature for every hologram"
      },
      "fitMargin": {
        "$type": "number",
        "$value": 1.04,
        "$description": "Scale past the furthest drawn point"
      },
      "minHeightShare": {
        "$type": "number",
        "$value": 0.4,
        "$description": "The dome is never lower than this share of its wider horizontal radius"
      },
      "burnFrequency": {
        "$type": "number",
        "$value": 2.8,
        "$description": "Burn noise cycles across the dome's wider radius: fewer, larger holes as it falls"
      },
      "burnThreshold": {
        "$type": "number",
        "$value": 0.4,
        "$description": "Noise level where the shell has burnt away; the fronts are where the noise crosses it"
      },
      "burnBreath": {
        "$type": "number",
        "$value": 0.03,
        "$description": "How far the threshold breathes, slowly, while the hologram is in focus"
      },
      "tearFrequency": {
        "$type": "number",
        "$value": 7,
        "$description": "Second noise that tears the fronts into dashes"
      },
      "tearFrom": {
        "$type": "number",
        "$value": 0.24,
        "$description": "Below this the front is torn away"
      },
      "tearTo": {
        "$type": "number",
        "$value": 0.4,
        "$description": "Above this it burns whole"
      },
      "corePx": {
        "$type": "number",
        "$value": 1.5,
        "$description": "The cream core of a front, in screen pixels"
      },
      "goldPx": {
        "$type": "number",
        "$value": 3.2,
        "$description": "Where the gold ends, in screen pixels from the front"
      },
      "charPx": {
        "$type": "number",
        "$value": 1.2,
        "$description": "The char past the gold, in screen pixels"
      },
      "glowPx": {
        "$type": "number",
        "$value": 9,
        "$description": "Where a front's glow ends, in screen pixels"
      },
      "glowShare": {
        "$type": "number",
        "$value": 0.22,
        "$description": "The glow's brightness beside the gold"
      },
      "lineGain": {
        "$type": "number",
        "$value": 1.3,
        "$description": "Brightness of gold and cream in a front"
      },
      "quietRest": {
        "$type": "number",
        "$value": 2.6,
        "$description": "Out of focus: the front fades as (1 - N.V) to this power, so only the silhouette band shows"
      },
      "quietFocus": {
        "$type": "number",
        "$value": 1.1,
        "$description": "In focus: the same with this power, so the fronts reach further in"
      },
      "farSide": {
        "$type": "number",
        "$value": 0.75,
        "$description": "Strength of the far side, seen through the dome behind the event"
      },
      "closeNearShare": {
        "$type": "number",
        "$value": 0.75,
        "$description": "Zoomed in, the near side's fronts at this share (Codex, 2026-10-25)"
      },
      "closeFromPx": {
        "$type": "number",
        "$value": 300,
        "$description": "The dome's on-screen radius, in device pixels, where the near side starts to step back"
      },
      "closeToPx": {
        "$type": "number",
        "$value": 700,
        "$description": "and where it is at closeNearShare"
      },
      "depthDim": {
        "$type": "number",
        "$value": 0.6,
        "$description": "How much dimmer the farthest point of the dome is than the nearest"
      },
      "emberCount": {
        "$type": "number",
        "$value": 2500,
        "$description": "Embers in and just off the dome's surface"
      },
      "emberRestShare": {
        "$type": "number",
        "$value": 0.45,
        "$description": "Share of the embers drifting out of focus"
      },
      "emberSpread": {
        "$type": "number",
        "$value": 0.025,
        "$description": "How far embers sit off the surface, as a share of the wider radius"
      },
      "emberDrift": {
        "$type": "number",
        "$value": 0.006,
        "$description": "How far an ember drifts, as a share of the wider radius"
      },
      "emberSize": {
        "$type": "number",
        "$value": 0.009,
        "$description": "Ember size as a share of the wider radius, before the pixel clamp"
      },
      "emberMinPx": {
        "$type": "number",
        "$value": 1.6
      },
      "emberMaxPx": {
        "$type": "number",
        "$value": 3.5,
        "$description": "No ember grows past this, so none becomes a bokeh disc"
      },
      "emberNearFrom": {

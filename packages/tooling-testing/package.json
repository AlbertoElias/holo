{
  "name": "@holoim/tooling-testing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test src/dev-server.test.mjs",
    "verify:fast": "node --check src/dev-server.mjs && node --check src/xr-env.mjs && node --check src/iwer-phone.mjs && node --check src/preview.mjs && pnpm run test"
  },
  "exports": {
    "./dev-server": {
      "types": "./src/dev-server.d.ts",
      "default": "./src/dev-server.mjs"
    },
    "./xr-env": {
      "types": "./src/xr-env.d.ts",
      "default": "./src/xr-env.mjs"
    },
    "./iwer-phone": {
      "types": "./src/iwer-phone.d.ts",
      "default": "./src/iwer-phone.mjs"
    },
    "./preview": {
      "types": "./src/preview.d.ts",
      "default": "./src/preview.mjs"
    }
  },
  "dependencies": {
    "@holoim/xr-runtime": "workspace:*",
    "iwer": "^2.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1"
  }
}

{
  "name": "@holoim/design-tokens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./three": "./src/three.ts",
    "./tokens.css": "./src/generated/tokens.css",
    "./tokens.json": "./src/generated/tokens.json",
    "./fonts.css": "./src/fonts/fonts.css"
  },
  "scripts": {
    "generate": "tsx scripts/generate.ts",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx scripts/generate.ts --check && vitest run",
    "verify:fast": "pnpm run lint && pnpm run typecheck",
    "verify:full": "pnpm run verify:fast && pnpm run test"
  },
  "peerDependencies": {
    "three": "*"
  },
  "peerDependenciesMeta": {
    "three": {
      "optional": true
    }
  },
  "devDependencies": {
    "@holoim/config-eslint": "workspace:*",
    "@holoim/config-ts": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/three": "catalog:",
    "eslint": "catalog:",
    "three": "catalog:",
    "tsx": "^4.19.2",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
